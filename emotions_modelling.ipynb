    "# plot the largest coefficients per class\n",
    "feature_names = tf_idf.get_feature_names_out()\n",
    "class_names = log_reg.classes_\n",
    "top_n = 10\n",
    "\n",
    "all_rows = []\n",
    "\n",
    "for i, cls in enumerate(class_names):\n",
    "    coef = log_reg.coef_[i]\n",
    "    df_cls = pd.DataFrame({\n",
    "        \"feature\": feature_names,\n",
    "        \"coef\": coef,\n",
    "        \"class\": cls\n",
    "    })\n",
    "    df_cls[\"abs_coef\"] = df_cls[\"coef\"].abs()\n",
    "    all_rows.append(df_cls.sort_values(\"abs_coef\", ascending=False).head(top_n))\n",
    "\n",
    "top_features = pd.concat(all_rows, ignore_index=True)\n",
    "\n",
    "n_classes = len(class_names)\n",
    "fig, axes = plt.subplots(n_classes, 1, figsize=(12, 4 * n_classes))\n",
    "\n",
    "for ax, cls in zip(axes, class_names):\n",
    "    df_cls = top_features[top_features[\"class\"] == cls].sort_values(\"coef\", ascending=False)\n",
    "\n",
    "    colors = [\"green\" if v >= 0 else \"red\" for v in df_cls[\"coef\"]]\n",
    "    ax.barh(df_cls[\"feature\"], df_cls[\"coef\"], color=colors)\n",
    "    ax.axvline(0, color=\"black\", linewidth=0.8)\n",
    "    ax.set_title(f\"Top features for class: {cls}\")\n",
    "    ax.invert_yaxis()\n",
    "    ax.set_xlabel(\"Coefficient\")\n",
    "    ax.set_ylabel(\"Feature\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
