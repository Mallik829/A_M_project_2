    "# define top 20 words\n",
    "top_20_words = df['adjectives'].explode()\n",
    "\n",
    "# remove empty/placeholder values\n",
    "top_20_words = top_20_words[top_20_words.notna()]\n",
    "\n",
    "# strip brackets and quotes\n",
    "top_20_words = top_20_words.str.replace(r\"[\\[\\]'\\\"]\", \"\", regex=True)\n",
    "\n",
    "# remove empty strings\n",
    "top_20_words = top_20_words[top_20_words != \"\"]\n",
    "\n",
    "# count words\n",
    "top_20_words = top_20_words.value_counts().head(20)\n",
    "for word in top_20_words.index:\n",
    "    print(word)\n",
    "    feature_names = tf_idf.get_feature_names_out()\n",
    "    word_idx = np.where(feature_names == word)[0][0]\n",
    "\n",
    "    # coefficients for this word across all classes\n",
    "    coef_table = pd.DataFrame({\n",
    "        \"class\": log_reg.classes_,\n",
    "        \"coefficient\": log_reg.coef_[:, word_idx]\n",
    "    })\n",
    "\n",
    "    print(coef_table.sort_values(\"coefficient\", ascending=False))"
   ]
